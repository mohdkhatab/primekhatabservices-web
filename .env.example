# Optional — site works fully WITHOUT Supabase (falls back to data/deals.json)
# Fill these after creating a Supabase project — see SUPABASE_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://primekhatab.in
# Optional: Supabase Edge Function API base, e.g.
# https://YOUR-PROJECT.supabase.co/functions/v1/api
# Read priority: API base -> Supabase table -> data/deals.json
NEXT_PUBLIC_API_BASE=

# Server-only (NEVER expose in browser code)
SUPABASE_SERVICE_ROLE_KEY=
# Protects POST/PATCH/DELETE /api/admin/deals  (Authorization: Bearer <this>)
ADMIN_API_KEY=

# --- MCP server (mcp/ folder, set these on the MCP host, not Vercel) ---
# MCP_CLIENT_ID=
# MCP_CLIENT_SECRET=
# MCP_TOKEN_SECRET=
# MCP_ADMIN_TOKEN=
# SUPABASE_URL=            (same as NEXT_PUBLIC_SUPABASE_URL)
